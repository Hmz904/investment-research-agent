{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisagent.local/schemas/evaluation_request_v0.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_schema_version": {
      "const": "evaluation_request_v0.2"
    },
    "split": {
      "enum": [
        "DEV",
        "TEST"
      ]
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "eval_protocol_v0.2.2"
        },
        "taxonomy_version": {
          "const": "execution_taxonomy_v0.1"
        },
        "agent_output_schema_version": {
          "const": "agent_output_v0.1.1"
        },
        "mapping_spec_version": {
          "const": "xbrl_gold_mapping_spec_v0.1.2"
        },
        "evaluator_contract_version": {
          "const": "d2_contract_v0.2"
        },
        "xbrl_artifact_fingerprint": {
          "const": "acaf087ee2c4fb7427377cae5f1968da26c75d4dfa565f67f1e056b2c4cc4eb6"
        },
        "corpus_fingerprint": {
          "const": "56df698d50b13cf15e913c1c60dbc96b1fd0fab44adb7b1f40ba99771c4b7c96"
        }
      },
      "required": [
        "protocol_version",
        "taxonomy_version",
        "agent_output_schema_version",
        "mapping_spec_version",
        "evaluator_contract_version",
        "xbrl_artifact_fingerprint",
        "corpus_fingerprint"
      ]
    },
    "gold_bundle": {
      "$ref": "gold_bundle_v0.2.schema.json"
    },
    "slot_record": {
      "$ref": "evaluation_slot_record_v0.2.schema.json"
    },
    "agent_output_json": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_output_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "chunk_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "accession": {
            "type": "string",
            "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "source_allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "chunk_id",
          "accession",
          "locator",
          "source_allowed"
        ]
      }
    },
    "normalized_xbrl_map": {
      "anyOf": [
        {
          "$ref": "normalized_xbrl_map_v0.2.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_xbrl_fact_index": {
      "anyOf": [
        {
          "$ref": "frozen_xbrl_fact_index_v0.1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "xbrl_numeric_values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_locator": {
            "type": "string",
            "minLength": 1
          },
          "normalized_value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fact_locator",
          "normalized_value"
        ]
      }
    }
  },
  "required": [
    "request_schema_version",
    "split",
    "contract_identity",
    "gold_bundle",
    "slot_record",
    "agent_output_json",
    "agent_output_sha256",
    "chunk_catalog",
    "normalized_xbrl_map",
    "frozen_xbrl_fact_index",
    "xbrl_numeric_values"
  ]
}
