{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisagent.local/schemas/gold_bundle_v0.2.schema.json",
  "title": "GoldBundle v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "adapter_version",
    "source_format_version",
    "question_id",
    "numeric_targets",
    "answer_groups",
    "judge_dependent_gold",
    "source_sha256"
  ],
  "properties": {
    "bundle_schema_version": {
      "const": "gold_bundle_v0.2"
    },
    "adapter_version": {
      "const": "gold_bundle_adapter_v0.2"
    },
    "source_format_version": {
      "enum": [
        "gold_bundle_v0.2",
        "gold_bundle_v0.1",
        "dev_gold_csv_bundle_v0.1"
      ]
    },
    "question_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "numeric_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/numeric_target"
      }
    },
    "answer_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/answer_group"
      }
    },
    "judge_dependent_gold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "part_id": {
                "type": "string",
                "minLength": 1
              },
              "required_semantics": {
                "type": "string",
                "minLength": 1
              },
              "importance": {
                "enum": [
                  "core",
                  "supporting",
                  "optional"
                ]
              },
              "stance": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "temporal_role": {
                "enum": [
                  "prior_period",
                  "current",
                  "change",
                  "cross_company",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "item_id",
              "part_id",
              "required_semantics",
              "importance",
              "stance",
              "temporal_role"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "plain_decimal": {
      "type": "string",
      "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
    },
    "precision_record": {
      "$ref": "precision_record_v0.2.schema.json"
    },
    "chunk_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "accession",
        "locator"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "accession": {
          "type": "string",
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chunk_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "members"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chunk_identity"
          }
        }
      }
    },
    "xbrl_path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_identity": {
          "$ref": "frozen_xbrl_fact_index_v0.1.schema.json#/$defs/fact"
        },
        "normalized_value": {
          "type": "string",
          "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
        },
        "review_status": {
          "const": "APPROVE"
        },
        "sign_relationship": {
          "enum": [
            "same_sign",
            "opposite_sign_explicitly_approved"
          ]
        },
        "sign_approval": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gold_display_sign": {
                  "type": "string",
                  "minLength": 1
                },
                "gold_economic_sign": {
                  "type": "string",
                  "minLength": 1
                },
                "xbrl_sign": {
                  "type": "string",
                  "minLength": 1
                },
                "basis_relation": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "gold_display_sign",
                "gold_economic_sign",
                "xbrl_sign",
                "basis_relation",
                "rationale"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path_id",
        "candidate_id",
        "fact_identity",
        "normalized_value",
        "review_status",
        "sign_relationship",
        "sign_approval"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "sign_relationship": {
                "const": "opposite_sign_explicitly_approved"
              }
            }
          },
          "then": {
            "properties": {
              "sign_approval": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "numeric_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "accepted_value",
        "unit",
        "period",
        "basis",
        "precision",
        "variant_family",
        "approved_chunk_paths",
        "approved_xbrl_paths"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_value": {
          "$ref": "#/$defs/plain_decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "$ref": "#/$defs/precision_record"
        },
        "variant_family": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "approved_chunk_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk_path"
          }
        },
        "approved_xbrl_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xbrl_path"
          }
        }
      }
    },
    "required_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_role",
        "source_target_id",
        "source_answer_group_id"
      ],
      "properties": {
        "input_role": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "source_target_id": {
          "type": "string",
          "minLength": 1
        },
        "source_answer_group_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "formula_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula_variant_id",
        "canonical_formula"
      ],
      "properties": {
        "formula_variant_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_formula": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "derived_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_target_id",
        "required_inputs",
        "allowed_formula_variants",
        "output_unit",
        "output_precision"
      ],
      "properties": {
        "derived_target_id": {
          "type": "string",
          "minLength": 1
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/required_input"
          }
        },
        "allowed_formula_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formula_variant"
          }
        },
        "output_unit": {
          "type": "string",
          "minLength": 1
        },
        "output_precision": {
          "$ref": "#/$defs/precision_record"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "variant_family",
        "numeric_target_id",
        "accepted_value",
        "unit",
        "period",
        "basis",
        "sign_policy",
        "precision",
        "approved_chunk_paths",
        "approved_xbrl_paths",
        "derived_specification"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_family": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "numeric_target_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_value": {
          "$ref": "#/$defs/plain_decimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "sign_policy": {
          "enum": [
            "SIGNED_EXACT",
            "REGISTERED_VARIANT"
          ]
        },
        "precision": {
          "$ref": "#/$defs/precision_record"
        },
        "approved_chunk_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk_path"
          }
        },
        "approved_xbrl_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xbrl_path"
          }
        },
        "derived_specification": {
          "anyOf": [
            {
              "$ref": "#/$defs/derived_specification"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "answer_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_group_id",
        "multiplicity",
        "question_consistency_group",
        "variants"
      ],
      "properties": {
        "answer_group_id": {
          "type": "string",
          "minLength": 1
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1
        },
        "question_consistency_group": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    }
  },
  "x-cross-record-constraints": [
    "answer_group_id values are unique and ordered as serialized.",
    "numeric target IDs are unique and every answer variant target resolves.",
    "variant_id and numeric_target_id values are unique where identity requires it.",
    "required input target IDs resolve without cycles.",
    "formula input_role tokens exactly equal required_inputs roles."
  ]
}
