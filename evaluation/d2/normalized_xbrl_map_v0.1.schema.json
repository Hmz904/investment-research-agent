{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisagent.local/schemas/normalized_xbrl_map_v0.1.schema.json",
  "title": "NormalizedXBRLMap v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_map_schema_version", "adapter_version", "source_schema_version", "source_sha256", "targets"],
  "properties": {
    "normalized_map_schema_version": {"const": "normalized_xbrl_map_v0.1"},
    "adapter_version": {"const": "dev_xbrl_map_adapter_v0.1"},
    "source_schema_version": {"const": "dev_xbrl_map_v0.1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "temporal": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "instant"], "properties": {"kind": {"const": "instant"}, "instant": {"type": "string", "format": "date"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "period_start", "period_end"], "properties": {"kind": {"const": "duration"}, "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}}}
      ]
    },
    "fact_path": {
      "type": "object", "additionalProperties": false,
      "required": ["path_id", "candidate_id", "fact_locator", "accession", "concept", "context_ref", "unit", "normalized_value", "temporal", "dimensions", "chunk_id"],
      "properties": {
        "path_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "fact_locator": {"type": "string", "minLength": 1},
        "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "concept": {"type": "string", "minLength": 1},
        "context_ref": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"},
        "temporal": {"$ref": "#/$defs/temporal"},
        "dimensions": {"type": "array", "items": {"type": "object"}},
        "chunk_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "question_id", "state", "direct_approved_paths", "required_input_target_ids", "approved_upstream_path_target_ids"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["DIRECT_APPROVED", "DERIVED_VIA_APPROVED_INPUTS", "NO_APPROVED_XBRL_PATH"]},
        "direct_approved_paths": {"type": "array", "items": {"$ref": "#/$defs/fact_path"}},
        "required_input_target_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "approved_upstream_path_target_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "DIRECT_APPROVED"}}, "required": ["state"]}, "then": {"properties": {"direct_approved_paths": {"minItems": 1}, "required_input_target_ids": {"maxItems": 0}, "approved_upstream_path_target_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"state": {"const": "DERIVED_VIA_APPROVED_INPUTS"}}, "required": ["state"]}, "then": {"properties": {"direct_approved_paths": {"maxItems": 0}, "required_input_target_ids": {"minItems": 1}, "approved_upstream_path_target_ids": {"minItems": 1}}}},
        {"if": {"properties": {"state": {"const": "NO_APPROVED_XBRL_PATH"}}, "required": ["state"]}, "then": {"properties": {"direct_approved_paths": {"maxItems": 0}, "approved_upstream_path_target_ids": {"maxItems": 0}}}}
      ]
    }
  },
  "x-cross-record-constraints": [
    "target_id values are unique.",
    "Every required input target resolves.",
    "DERIVED_VIA_APPROVED_INPUTS lineage is acyclic and every leaf is DIRECT_APPROVED.",
    "Approved candidate IDs and exact fact identities reproduce the frozen source map."
  ]
}
